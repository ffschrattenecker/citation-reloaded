{
  "name": "citation-reloaded",
  "version": "0.5.2",
  "description": "Automatically search and insert citations from a Zotero library",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "format": "prettier --write src *.json *.md"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "zotero",
    "citations",
    "bibtex",
    "biblatex",
    "csl-json"
  ],
  "author": "Franz Schrattenecker",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "obsidian": "git+https://github.com/obsidianmd/obsidian-api.git#master",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "^3.2.30",
    "chokidar": "^3.6.0",
    "handlebars": "^4.7.8",
    "promise-worker": "^2.0.1"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1",
      "^obsidian$": "<rootDir>/src/__tests__/mocks/obsidian.ts",
      "^web-worker:./worker$": "<rootDir>/src/__tests__/mocks/web-worker.ts",
      "^promise-worker$": "<rootDir>/src/__tests__/mocks/promise-worker.ts",
      "^original-fs$": "<rootDir>/src/__tests__/mocks/original-fs.ts"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "d.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "overrides": {
    "deepmerge": "^4.3.1",
    "minimatch": "^11.0.5"
  }
}
